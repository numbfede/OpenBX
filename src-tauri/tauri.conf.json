{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBX",
  "version": "0.1.4",
  "identifier": "com.openbx.optimizer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenBX",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 700,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#09090B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Human-first Windows optimizer",
    "longDescription": "OpenBX checks real Windows settings, applies only documented safe optimizations, and can restore every change.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
